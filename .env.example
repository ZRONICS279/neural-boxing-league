OPENAI_API_KEY=
OPENAI_STRATEGY_MODEL=gpt-5.6-terra
OPENAI_VOICE_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=ash
SIM3D_SERVICE_URL=
SIM3D_SERVICE_TOKEN=

# Personal Cloudflare deployment. Leave FORGE_SELF_HOSTED empty for the Sites
# source build; set it to 1 only when building the Worker in your own account.
FORGE_SELF_HOSTED=
FORGE_D1_DATABASE_NAME=
FORGE_D1_DATABASE_ID=
FORGE_CUSTOM_DOMAIN=
FORGE_MIGRATION_IMPORT=
FORGE_CRON_ENABLED=

# The betting book — the contracts in chain/. Unset means no market at all: the
# panel says so and the league runs exactly as before. These are the live
# Robinhood testnet addresses, from chain/deployments/robinhoodTestnet-fightcard.json.
FIGHT_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# Handed to the browser for wallet_addEthereumChain, so it ends up saved in
# somebody's wallet settings and must have no key in it. FIGHT_RPC_URL stays
# server-side and may.
FIGHT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
FIGHT_CHAIN_ID=46630
FIGHT_CLOB_ADDRESS=0xF04910AB1DAc2853655EeF916565D342A1b952a1
FIGHT_READER_ADDRESS=0xE368E388a24F194d734606cC69497Ddb9dcEF0E4
FIGHT_CARD_PARLAY=0x7f28e14DDbC07CaBE70c4B995e148618C90Aad3e
# Robinhood testnet's own USDC. Traders need some; the league does not need any
# to run, and did not need any to deploy.
FIGHT_COLLATERAL_ADDRESS=0xAc80194dc1aE8eF52df73e7e1864fB3C62290fe0
FIGHT_COLLATERAL_DECIMALS=6
FIGHT_COLLATERAL_SYMBOL=USDC
FIGHT_TAKER_FEE_BPS=100
# The block the CLOB was deployed in. The league's event index starts reading
# the book's logs here; left at 0 it spends its first minutes walking 96M empty
# blocks before it reaches the first trade.
FIGHT_START_BLOCK=96795485
FIGHT_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# The only key the league holds, and a Wrangler secret in production rather
# than a file. Its absence makes the operator a no-op: nothing is booked,
# closed, scored or quoted. It can never touch anyone else's collateral.
FIGHT_OPERATOR_KEY=
# Shares quoted on each corner of a new bout, and the cents between the
# league's line and the price it will actually pay. 0 shares turns the opening
# quote off and leaves every book to whoever gets there first.
FIGHT_SEED_SHARES=25
FIGHT_SEED_SPREAD=2
